# Copie para .env.local (no computador) ou cadastre na Vercel (Settings > Environment Variables).
# Nunca faça commit de chaves reais.

# --- Supabase (obrigatório: login, banco e permissões) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Segredo: só no servidor. Usado apenas para a equipe liberar o acesso de um cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (usado no link de acesso enviado ao cliente)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Pesquisas reais ---
# SerpApi: voos (Google Flights) e hospedagem (Google Hotels, inclusive aluguel por temporada).
# Sem a chave, as buscas mostram DADOS DE EXEMPLO, sempre marcados.
SERPAPI_KEY=
