# Copie para .env e preencha. Nunca faça commit do .env.
# As fontes gratuitas (Kiwi, Skiplagged, Trivago, Ferryhopper, Airbnb) funcionam sem nenhuma chave.

# --- IA (necessária quando virar app, Fase 2) ---
ANTHROPIC_API_KEY=

# --- Hotéis ---
LITEAPI_API_KEY=            # tarifas de hotel ao vivo (liteapi.travel)

# --- Voos (opcionais, melhoram a precisão) ---
DUFFEL_API_KEY=             # preços reais de GDS (duffel.com)
SERPAPI_API_KEY=            # Google Flights / Google Hotels (serpapi.com)
SEATS_AERO_API_KEY=         # disponibilidade de emissões com milhas (seats.aero)

# --- Banco de dados / backend (Fase 2) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
